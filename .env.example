# Lango runs fully in demo mode with NO keys. Add keys to enable real AI.

# OpenAI: Whisper speech-to-text (/api/stt) and TTS voice "alloy" (/api/tts)
OPENAI_API_KEY=

# Anthropic: Claude tutor (/api/tutor) and notebook vision grading (/api/grade-notebook)
ANTHROPIC_API_KEY=

# Optional: override the tutor / grading model
# LANGO_TUTOR_MODEL=claude-opus-5-5

# Optional: force mock responses even when keys are present
# LANGO_FORCE_MOCK=1
